{
  "expo": {
    "name": "sonora",
    "slug": "sonora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-sonora.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090815",
        "foregroundImage": "./assets/logo-sonora.png"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o Sonora acesse suas fotos para definir a capa dos álbuns.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "favicon": "./assets/logo-sonora.png"
    }
  }
}
